# 本程序从环境变量读取配置，不会自动加载 .env 文件。
# 默认无需模型。设置以下变量后重启，再在页面选择“模型模式”。
# MODEL_BASE_URL 必须包含 /v1，且必须是你信任的模型服务地址。
MODEL_BASE_URL=http://127.0.0.1:4000/v1
MODEL_API_KEY=replace-with-your-service-key
MODEL_ALIASES=reminder-fast,planner-strong

# AI 工作流可沿用以上模型地址和密钥，也可单独配置。
# 只理解回复，不会让模型执行任意脚本或更改收件人。
# WORKFLOW_MODEL_BASE_URL=https://your-compatible-service.example/v1
# WORKFLOW_MODEL_API_KEY=replace-locally
WORKFLOW_MODEL=planner-strong

# 多人后端：默认仅站内通知，固定技能无需模型接口。
# 微信签名桥接可单独启用；请在本机生成至少32字符的随机值，勿使用示例口令。
# TEAM_BRIDGE_SECRET=<本机私有随机密钥>
# 只有显式传入 --enable-wechat 后，才使用以下已有授权网关发送。
# TEAM_WECHAT_GATEWAYS=[{"profile":"C:/private/authorized-profile","port":18791}]
# 接入和切换步骤见 docs/team-backend/OPERATIONS.md。
